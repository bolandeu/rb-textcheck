{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bolandeu/textcheck/quality-profile.schema.json",
  "title": "quality.yml",
  "description": "Профиль качества текста (формат antagor prompts/*.quality.yml). Секции сливаются с дефолтами по отдельным ключам; неизвестная секция верхнего уровня - ошибка.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "count": {"type": ["integer", "null"], "minimum": 0},
    "strings": {"type": ["array", "null"], "items": {"type": "string"}}
  },
  "properties": {
    "length": {
      "description": "Длина чистого текста без разметки, в символах.",
      "type": "object",
      "properties": {
        "min_chars": {"$ref": "#/$defs/count"},
        "max_chars": {"$ref": "#/$defs/count"},
        "tolerance": {"type": "number", "minimum": 0, "description": "Допуск к границам, доля (0.1 = 10%)."},
        "gate": {"type": "boolean", "description": "false - нехватка длины к сведению, не валит текст. Превышение максимума не валит никогда."}
      }
    },
    "headings": {
      "type": "object",
      "properties": {
        "h2_min": {"$ref": "#/$defs/count"},
        "h2_max": {"$ref": "#/$defs/count"},
        "forbid_colon": {"type": "boolean", "description": "Двоеточие в любом заголовке h2-h6 - нарушение."}
      }
    },
    "tags": {
      "type": "object",
      "properties": {
        "forbidden": {"$ref": "#/$defs/strings"},
        "required": {"$ref": "#/$defs/strings"}
      }
    },
    "cliches": {"description": "Фразы-клише, ищутся без учёта регистра.", "$ref": "#/$defs/strings"},
    "forbid": {
      "description": "Предметные запреты. Добавляются к запретам пайплайна, не заменяют их.",
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "regex": {"type": "string", "description": "Python re, без учёта регистра."},
          "judge": {"type": "string", "description": "Та же мысль словами - для судьи; textcheck её не применяет."}
        },
        "anyOf": [
          {"required": ["regex"], "properties": {"regex": {"minLength": 1}}},
          {"required": ["judge"], "properties": {"judge": {"minLength": 1}}}
        ]
      }
    },
    "humanizer": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "error_is_gate": {"type": "boolean"},
        "max_warnings": {"$ref": "#/$defs/count"},
        "mute": {"description": "Подстроки названий правил линтера, которые не считаются.", "$ref": "#/$defs/strings"}
      }
    },
    "language": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "script": {"type": "string", "description": "cyrillic - иначе считается латиница."},
        "min_share": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "grounding": {
      "description": "Для LLM-проверки в antagor; textcheck не применяет.",
      "type": "object",
      "properties": {
        "report_only": {"type": "boolean"},
        "min_grounded_share": {"type": ["number", "null"]}
      }
    },
    "judge_model": {"description": "Для LLM-судьи в antagor; textcheck не применяет.", "type": ["string", "null"]},
    "generation": {
      "description": "Блок ограничений для промта генерации; textcheck не применяет.",
      "type": "object",
      "properties": {"constraints": {"type": "string"}}
    }
  }
}
