      {
        "name": "check",
        "description": "Check a text against a quality profile: findings, humanizer verdict, gate.\n\nDeterministic, no network and no LLM. Every finding has rule, message,\nexcerpt, gate, unit, address and action; `textcheck rules` lists the rules.\nExit 0: the gate passed (findings with gate=false are for information).\nExit 1: findings with gate=true — the report is still emitted (ok=false,\nerror QUALITY_GATE_FAILED). Exit 2: bad arguments or profile.\n\nExample: textcheck check article.html --profile content-logistics.quality.yml --json",
        "options": [
          {
            "name": "--profile",
            "arguments": [
              {
                "name": "PROFILE",
                "required": true,
                "arity": {
                  "maximum": 1
                }
              }
            ],
            "description": "Quality profile (quality.yml). Without it: built-in defaults only.",
            "metadata": [
              {
                "name": "x-rb-type",
                "value": "path"
              },
              {
                "name": "x-rb-default",
                "value": null
              }
            ]
          },
          {
            "name": "--format",
            "arguments": [
              {
                "name": "TEXT_FORMAT",
                "required": true,
                "arity": {
                  "maximum": 1
                }
              }
            ],
            "description": "html or md. Default: md for .md/.markdown files, html otherwise (and for stdin).",
            "metadata": [
              {
                "name": "x-rb-type",
                "value": "str"
              },
              {
                "name": "x-rb-default",
                "value": null
              }
            ]
          },
          {
            "name": "--json",
            "description": "Emit machine-readable JSON output.",
            "metadata": [
              {
                "name": "x-rb-type",
                "value": "boolean"
              },
              {
                "name": "x-rb-default",
                "value": false
              }
            ]
          },
          {
            "name": "--quiet",
            "description": "Suppress non-essential output.",
